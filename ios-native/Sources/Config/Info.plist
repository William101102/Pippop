<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Pinpop</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pinpop.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pinpop</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pinpop.app.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>GIDClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Pinpop uses Bluetooth to find friends who are right next to you.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_pinpop-bump._tcp</string>
		<string>_pinpop-bump._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo for your avatar or a Highlight.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pinpop discovers friends standing next to you to set up a bump.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Pinpop keeps sharing your location with the friends you choose while the app is in the background, so their map stays live. You can switch to Blurred or Frozen, or turn sharing off, at any time.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Pinpop shows you and your friends on a shared live map.</string>
	<key>NSMotionUsageDescription</key>
	<string>Pinpop uses motion to detect a shake or a knock on the back of your phone as a shortcut for waving at friends.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>Pinpop uses ultra-wideband to show the exact distance and direction to a nearby friend so you can find each other and bump to say hi.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick a photo for your avatar or a Highlight.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Fredoka-Medium.ttf</string>
		<string>Fredoka-SemiBold.ttf</string>
		<string>Fredoka-Bold.ttf</string>
		<string>DMSans-Medium.ttf</string>
		<string>DMSans-SemiBold.ttf</string>
		<string>DMSans-Bold.ttf</string>
		<string>DMSans-ExtraBold.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>

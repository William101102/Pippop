// Copy to Secrets.xcconfig (gitignored) and fill in.
// project.yml wires this to both Debug and Release automatically — no manual
// Xcode setup needed, and it survives `xcodegen generate`.

// Supabase project URL, without a trailing slash.
// The // in https:// must be escaped for xcconfig — hence $()/ below.
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co

// The ANON key only. A service-role key in a shipped app is a full database
// compromise — it bypasses every RLS policy.
SUPABASE_ANON_KEY = your-anon-key

// From Google Cloud console → Credentials → iOS OAuth client.
GOOGLE_CLIENT_ID = 000000000000-xxxxxxxx.apps.googleusercontent.com
// Same value with the components reversed, used as a URL scheme.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-xxxxxxxx

// Xcode → Settings → Accounts → your Apple ID → team name shows this in
// parentheses, e.g. "William Huang (2AK7AZD4A5)" — or it's the code in
// parentheses on the "untrusted developer" screen on the device itself, e.g.
// "Apple Development: you@example.com (2AK7AZD4A5)". A free/personal team
// works here too, with the limits noted in Pinpop.entitlements.
DEVELOPMENT_TEAM = YOURTEAMID

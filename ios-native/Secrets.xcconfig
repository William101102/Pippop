// Copy to Secrets.xcconfig (gitignored) and fill in.
// In Xcode: Project → Info → Configurations → set both Debug and Release to
// this file, so the values reach Info.plist via $(...) substitution.

// Supabase project URL, without a trailing slash.
// The // in https:// must be escaped for xcconfig — hence $()/ below.
SUPABASE_URL = https:/$()/nzqgkbibuqnfbxfarswu.supabase.co

// The ANON key only. A service-role key in a shipped app is a full database
// compromise — it bypasses every RLS policy.
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im56cWdrYmlidXFuZmJ4ZmFyc3d1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMzg0NzgsImV4cCI6MjEwMzYxNDQ3OH0.olf2ccc_Y7yQj96Ls3BJja-jyJsr3YzUL2UXGFriApU

// From Google Cloud console → Credentials → iOS OAuth client.
GOOGLE_CLIENT_ID = 441531546416-gthskjgph0hpaom0201ujdbt63ogremv.apps.googleusercontent.com
// Same value with the components reversed, used as a URL scheme.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.441531546416-gthskjgph0hpaom0201ujdbt63ogremv

// Xcode personal/free team ID — see Secrets.example.xcconfig for where to find it.
DEVELOPMENT_TEAM = 2AK7AZD4A5
